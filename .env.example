# Copy this to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase ---
# Project URL and anon key: Supabase dashboard → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: same page. NEVER expose this to the browser — server-side
# env var only (Vercel: do not check "Expose to browser").
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4: Gmail OAuth client (separate from Supabase Auth's Google login client) ---
# Google Cloud Console → APIs & Services → Credentials → this app's
# "Gmail connection" OAuth client (NOT the one used for Supabase Auth login).
# Authorized redirect URI: https://<your-domain>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Later: Gemini (not needed yet) ---
# GEMINI_API_KEY=
